{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    },
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      "style": {
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "fix": "safe",
          "options": { "style": "type" }
        }
      }
    }
  }
}
